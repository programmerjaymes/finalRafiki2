# PostgreSQL (Netlify Database, Neon, RDS, local Postgres, etc.)
#
# Production (Netlify + Neon):
# - Use Neon "Pooled connection" for serverless (fewer "too many connections" errors).
# - Set DATABASE_URL in Netlify → Environment variables for Production (API runtime needs it, not only build).
# - sslmode=require is auto-added for neon.tech / supabase / common cloud hosts if missing.
#
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-secret"
